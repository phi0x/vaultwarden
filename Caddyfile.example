# Caddyfile.example — vaultwarden reverse proxy with diagnostics-tuned headers
#
# Why this is more than `reverse_proxy vaultwarden:80`:
#
#   1. The vaultwarden admin diagnostics page (/admin/diagnostics) checks
#      that you're forwarding the real client IP via X-Real-IP / X-Forwarded-For
#      and that proxy timeouts are sane. This config makes those green.
#
#   2. The web vault embeds 2FA / FIDO2 challenges in popups. Strict
#      X-Frame-Options and frame-ancestors CSPs break those popups, so the
#      @twofa matcher strips those headers ONLY on the 2FA endpoints.
#
#   3. The default web vault calls out to https://api.pwnedpasswords.com
#      (breach checks) and https://api.2fa.directory (the 2FA service catalog).
#      The CSP allow-lists those exact origins.
#
#   4. The web vault requests sourcemaps that vaultwarden doesn't ship; the
#      *.map 404 rule keeps DevTools quiet without 404s in the access log.
#
# Replace YOUR_DOMAIN_HERE with your actual hostname.

YOUR_DOMAIN_HERE {
    encode zstd gzip

    tls {
        protocols tls1.2 tls1.3
    }

    # Global security headers. `Referrer-Policy: same-origin` is required by
    # vaultwarden's /admin/diagnostics HTTP-response check — the test looks
    # for the literal substring `same-origin` in the header value, so the
    # otherwise-reasonable `strict-origin-when-cross-origin` fails the check.
    # `same-origin` is also strictly more private (no referrer leaks at all
    # on cross-origin requests), which is what you want for a password vault.
    header {
        -server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }

    # 2FA / FIDO2 endpoints — popups need to be embeddable, so strip the
    # framing restrictions that the default `handle` block applies.
    @twofa {
        path /identity/connect/two-factor*
        path /identity/connect/two-factor-challenge*
        path /webauthn-connector.html
        path /identity/2fa-connector*
    }

    handle @twofa {
        header -X-Frame-Options
        header -Content-Security-Policy
        reverse_proxy vaultwarden:80 {
            header_up X-Real-IP {http.request.remote.host}
            header_up X-Forwarded-For {http.request.remote.host}
            header_down -X-Frame-Options
            header_down -Content-Security-Policy
        }
    }

    # All other traffic
    handle {
        header {
            X-Frame-Options "SAMEORIGIN"
            Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.pwnedpasswords.com https://api.2fa.directory"
            Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(self), usb=(), fullscreen=(self)"
        }

        # Notifications/websocket endpoint — explicit for clarity; modern
        # vaultwarden serves it on the main port, so this is functionally
        # the same as the catch-all below but documents the intent.
        reverse_proxy /notifications/hub* vaultwarden:80

        reverse_proxy vaultwarden:80 {
            header_up X-Real-IP {http.request.remote.host}
            header_up X-Forwarded-For {http.request.remote.host}
        }
    }

    # Suppress sourcemap 404s
    @map_files path *.map
    respond @map_files "Not Found" 404
}
