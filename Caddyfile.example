# Caddyfile.example — vaultwarden reverse proxy with diagnostics-tuned headers
#
# Why this is more than `reverse_proxy vaultwarden:80`:
#
#   1. The vaultwarden admin diagnostics page (/admin/diagnostics) checks
#      that you're forwarding the real client IP via X-Real-IP / X-Forwarded-For
#      and that proxy timeouts are sane. This config makes those green.
#
#   2. The web vault and the browser extensions load the WebAuthn / Duo / SSO
#      connector pages in an IFRAME. vaultwarden deliberately sends no framing
#      headers on those pages (it applies X-Frame-Options and its CSP to
#      everything else), so any X-Frame-Options the proxy adds becomes the only
#      policy on them -- and SAMEORIGIN blocks the extension, whose origin is
#      chrome-extension://..., from framing them. The @framed_connectors matcher
#      routes them past the header block. See that block for the full list.
#
#   3. There is deliberately NO Content-Security-Policy set here. vaultwarden
#      already sends its own, and when a response carries two CSP headers the
#      browser enforces the INTERSECTION of both — so a header added here can
#      only ever subtract from vaultwarden's policy, never loosen it. Setting
#      one is how you break the web vault. See the `handle` block below.
#
#   4. The web vault requests sourcemaps that vaultwarden doesn't ship; the
#      *.map 404 rule keeps DevTools quiet without 404s in the access log.
#
#   5. Caddy serves HTTP/3 by default and advertises it via Alt-Svc on every
#      response. That advertisement is a promise: if UDP 443 doesn't actually
#      reach Caddy, clients stall on a QUIC timeout before falling back to TCP.
#      Publishing `443:443/udp` (compose.yaml) is only half of it — your cloud
#      provider's firewall must allow UDP 443 too. See README §7.5.
#
# Replace YOUR_DOMAIN_HERE with your actual hostname.

YOUR_DOMAIN_HERE {
    encode zstd gzip

    tls {
        protocols tls1.2 tls1.3
    }

    # Global security headers. `Referrer-Policy: same-origin` is required by
    # vaultwarden's /admin/diagnostics HTTP-response check — the test looks
    # for the literal substring `same-origin` in the header value, so the
    # otherwise-reasonable `strict-origin-when-cross-origin` fails the check.
    # `same-origin` is also strictly more private (no referrer leaks at all
    # on cross-origin requests), which is what you want for a password vault.
    header {
        -server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }

    # Connector pages the web vault and the browser extensions load in an IFRAME
    # during WebAuthn / Duo / SSO.
    #
    # vaultwarden serves these as static files and sends NO framing headers on
    # them, by design, so that they can be framed. That means the
    # `X-Frame-Options: SAMEORIGIN` set by the catch-all `handle` below would be
    # the only policy on them, and SAMEORIGIN blocks the browser extension
    # (origin chrome-extension://...) from framing them -- extension-driven 2FA
    # then stalls with no useful error.
    #
    # Giving them their own `handle` short-circuits the catch-all so that header
    # is never applied. THAT is the mechanism; the strip below removes nothing
    # today and is only a guard in case vaultwarden starts sending one.
    #
    # Irrelevant to TOTP and email 2FA, which are plain form posts with no
    # iframe. Keep it anyway so enabling WebAuthn or Duo later just works.
    #
    # Do not add `-Content-Security-Policy` here. vaultwarden sends no CSP on
    # these paths, so it strips nothing -- and if a future release does start
    # sending one it will carry the correct frame-ancestors, which you want.
    @framed_connectors {
        path /webauthn-connector.html
        path /webauthn-fallback-connector.html
        path /webauthn-mobile-connector.html
        path /duo-redirect-connector.html
        path /sso-connector.html
        path /identity/2fa-connector*
    }

    handle @framed_connectors {
        header -X-Frame-Options
        reverse_proxy vaultwarden:80 {
            header_up X-Real-IP {http.request.remote.host}
            header_up X-Forwarded-For {http.request.remote.host}
        }
    }

    # All other traffic
    handle {
        header {
            X-Frame-Options "SAMEORIGIN"
            # Do NOT add a Content-Security-Policy here. Two CSP headers on one
            # response are intersected by the browser, and vaultwarden already
            # sends a good one. A policy like
            #   default-src 'self'; style-src ...; img-src ...; connect-src ...
            # looks harmless but declares no script-src, so script-src falls back
            # to default-src 'self' — which drops 'wasm-unsafe-eval' from
            # vaultwarden's policy. The 2026.x web vault runs its crypto in a
            # WebAssembly SDK, Chromium refuses to compile WASM without that
            # source, and unlock then hangs on the spinner with no visible error.
            # vaultwarden's own CSP is stricter (default-src 'none'), allow-lists
            # api.pwnedpasswords.com / api.2fa.directory / the alias-forwarding
            # APIs, sets frame-ancestors for the browser extensions, and is kept
            # in sync with each bundled web-vault release upstream. Let it pass.
            Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(self), usb=(), fullscreen=(self)"
        }

        # Notifications/websocket endpoint. Modern vaultwarden serves it on the
        # main port, so this routes to the same upstream as the catch-all — but
        # it must repeat the header_up lines. A reverse_proxy directive does not
        # inherit them, and because this route matches first, omitting them makes
        # vaultwarden log every websocket as coming from the Caddy container:
        #   Accepting Rocket WS connection from 172.x.x.x
        # which also defeats per-source rate limiting and fail2ban on that path.
        reverse_proxy /notifications/hub* vaultwarden:80 {
            header_up X-Real-IP {http.request.remote.host}
            header_up X-Forwarded-For {http.request.remote.host}
        }

        reverse_proxy vaultwarden:80 {
            header_up X-Real-IP {http.request.remote.host}
            header_up X-Forwarded-For {http.request.remote.host}
        }
    }

    # Suppress sourcemap 404s
    @map_files path *.map
    respond @map_files "Not Found" 404
}
