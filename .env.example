# Copy to .env and fill in. Never commit .env — it contains the admin token.

# Argon2 PHC hash. Generate with:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# You'll be prompted for a passphrase twice. The plain passphrase is what
# you type into the /admin login screen; the resulting $argon2id$... string
# is what goes here.
VAULTWARDEN_ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$REPLACE_ME$REPLACE_ME'

# Public URL of your vaultwarden install. Must match the domain block in
# Caddyfile and use https:// (Caddy auto-provisions the certificate).
DOMAIN=https://YOUR_DOMAIN_HERE

# ---------------------------------------------------------------------------
# Optional: SMTP via the environment instead of the admin panel.
#
# By default you configure mail in the admin panel, which stores the password
# in plaintext in config.json (see README §3). Uncomment these and add the
# matching SMTP_* entries to compose.yaml to keep the credential here instead —
# but you must also delete the smtp_* keys from config.json, because that file
# overrides the environment.
#
# Single-quote the password: Compose interpolates an unquoted '$'.
# After changing any value here, `docker compose up -d --force-recreate` —
# a plain `docker restart` keeps the old environment.
# ---------------------------------------------------------------------------
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURITY=starttls
#SMTP_FROM=you@example.com
#SMTP_USERNAME=you@example.com
#SMTP_PASSWORD='YOUR_APP_PASSWORD'
