# Copy to .env and fill in. Never commit .env — it contains the admin token.

# Argon2 PHC hash. Generate with:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# You'll be prompted for a passphrase twice. The plain passphrase is what
# you type into the /admin login screen; the resulting $argon2id$... string
# is what goes here.
VAULTWARDEN_ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$REPLACE_ME$REPLACE_ME'

# Public URL of your vaultwarden install. Must match the domain block in
# Caddyfile and use https:// (Caddy auto-provisions the certificate).
DOMAIN=https://YOUR_DOMAIN_HERE
